<resources>
    <!-- Base application theme. All actual UI theming (colors, dark mode) is done by
         BudgetCalcTheme in Compose; this XML theme only paints the window background
         for the instant before the first Compose frame, so it just mirrors Compose's
         backgroundLight/backgroundDark to avoid a flash of mismatched color. -->
    <style name="Theme.BudgetCalc" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">#FF141218</item>
    </style>
</resources>